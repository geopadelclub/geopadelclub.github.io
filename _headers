# ============================================================
# Cabeceras de seguridad para todas las rutas
# ============================================================
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(self), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# ============================================================
# Caché de assets estáticos (1 año, immutable)
# El SW tiene su propio cache encima, así que esto solo
# ayuda a la primera carga y a los clientes sin SW.
# ============================================================
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ============================================================
# HTML y SW: sin caché (siempre revalidar)
# ============================================================
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
/reservar
  Cache-Control: public, max-age=0, must-revalidate
/panel
  Cache-Control: public, max-age=0, must-revalidate
/tienda
  Cache-Control: public, max-age=0, must-revalidate
/privacidad
  Cache-Control: public, max-age=0, must-revalidate
/aviso-legal
  Cache-Control: public, max-age=0, must-revalidate
/politica-cookies
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# ============================================================
# CSP por página
# Fase 1: mantenemos 'unsafe-inline' en style-src (hay <style>
# inline y style="" en panel.html). Ya metemos frame-ancestors
# (que solo funciona por cabecera, no por <meta>) y reducimos
# img-src de https: a la lista blanca real.
# ============================================================

# --- Portada pública ---
/
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://geopadelclub.com https://*.supabase.co; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://geopadelclub.com https://*.supabase.co; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

